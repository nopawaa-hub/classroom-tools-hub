rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // No-auth, shared classroom dataset (per user's choice).
    // Anyone with the classroom URL can read + write the shared collections.
    // Be aware: a stranger who finds the URL could modify this data.
    // Upgrade later by adding auth/PIN without changing the data model.

    // Teacher-created data is stored under collections keyed by tool:
    //   /grammar_cases/{caseId}        — teacher-built grammar cases
    //   /vocab_custom/{wordId}         — teacher-built vocabulary
    //   /scoreboard_sessions/{sessionId} — saved scoreboard setups
    //   /classroom_state/{docId}       — misc shared state

    match /grammar_cases/{docId=**} {
      allow read, write: if true;
    }
    match /vocab_custom/{docId=**} {
      allow read, write: if true;
    }
    match /scoreboard_sessions/{docId=**} {
      allow read, write: if true;
    }
    match /classroom_state/{docId=**} {
      allow read, write: if true;
    }

    // Default: deny anything not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
